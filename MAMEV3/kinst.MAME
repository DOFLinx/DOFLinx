KEY_TO_COMMAND=,BUT_B1,Quick(HighAttack)1,BUT_B9,Quick(HighAttack)9,BUT_B2,Medium(HighAttack)2,BUT_B10,Medium(HighAttack)10,BUT_B3,Fierce(HighAttack)3,BUT_B11,Fierce(HighAttack)11,BUT_B4,Quick(LowAttack)4,BUT_B12,Quick(LowAttack)12,BUT_B5,Medium(LowAttack)5,BUT_B13,Medium(LowAttack)13,BUT_B6,Fierce(LowAttack)6,BUT_B14,Fierce(LowAttack)14
