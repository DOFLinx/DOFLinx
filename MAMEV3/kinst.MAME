[STARTUP]
BUTTON_COLOUR_CHANGE=BUT_EX,Orange,BUT_J1,Teal,BUT_J2,Teal,BUT_B1,cyan,BUT_B9,cyan,BUT_B2,cyan,BUT_B10,cyan,BUT_B3,cyan,BUT_B11,cyan,BUT_B4,cyan,BUT_B12,cyan,BUT_B5,cyan,BUT_B13,cyan,BUT_B6,cyan,BUT_B14,cyan
