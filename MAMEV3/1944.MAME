[STARTUP]
BUTTON_COLOUR_CHANGE=BUT_EX,White,BUT_P1,Orange_Red,BUT_P2,Dark_Green
BUTTON_COLOUR_CHANGE=BUT_J1,Light_Cyan,BUT_B1,Deep_Pink,BUT_B2,Dodger_Blue,BUT_J2,Light_Cyan,BUT_B9,Deep_Pink,BUT_B10,Dodger_Blue
