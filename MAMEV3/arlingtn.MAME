##################
#
# MAME configration for arlingtn
# DOFLinx force feedback configuration file v1
#
##################

[STARTUP]
BUTTON_COLOUR_CHANGE=BUT_EX,Orange,BUT_J1,violet,BUT_J2,Teal,BUT_B1,violet,BUT_B9,violet,BUT_B2,violet,BUT_B10,violet,BUT_B3,violet,BUT_B11,violet,BUT_B4,violet,BUT_B12,violet
BUTTONS_LIT_ADDED=,BUT_J1,BUT_J2,BUT_B9,BUT_B10,BUT_B3,BUT_B11,BUT_B4,BUT_B12
KEY_TO_COMMAND=,BUT_B1,WIN1,BUT_B9,WIN9,BUT_B2,PLACE2,BUT_B10,PLACE10,BUT_B3,SHOW3,BUT_B11,SHOW11,BUT_B4,COLLECT4,BUT_B12,COLLECT12
FF_DOF=E78,-1

[SHUTDOWN]
KEY_TO_COMMAND=
BUTTONS_LIT_DELETED=,BUT_J1,BUT_J2,BUT_B9,BUT_B10,BUT_B3,BUT_B11,BUT_B4,BUT_B12

[COMMANDS]
WIN1|ON|FF_DOF E206,-1,|FF_PC,U,D,ledstrip/zone/left_strip/effect/gun_muzzle_trail?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
WIN9|ON|FF_DOF E207,-1,|FF_PC,U,D,ledstrip/zone/right_strip/effect/gun_muzzle_trail?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
PLACE2|ON|FF_DOF E208,-1,|FF_PC,U,D,ledstrip/zone/left_strip/effect/explosion?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
PLACE10|ON|FF_DOF E209,-1,|FF_PC,U,D,ledstrip/zone/right_strip/effect/explosion?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
SHOW3|ON|FF_DOF E210,-1,|FF_PC,U,D,ledstrip/zone/left_strip/effect/gun_explosion_pulse?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
SHOW11|ON|FF_DOF E211,-1,|FF_PC,U,D,ledstrip/zone/right_strip/effect/gun_explosion_pulse?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
COLLECT4|ON|FF_DOF E212,-1,|FF_PC,U,D,ledstrip/zone/left_strip/effect/gun_flash_recoil?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
COLLECT12|ON|FF_DOF E213,-1,|FF_PC,U,D,ledstrip/zone/right_strip/effect/gun_flash_recoil?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
coin|ON|FF_DOF E78,0|FF_PC,U,D,ledstrip/batch?zones=left_speaker_ring~twinkle~!LED_R!~!LED_G!~!LED_B!~255~1~false@right_speaker_ring~twinkle~!LED_R!~!LED_G!~!LED_B!~255~1~false
player1|ON|FF_DOF E78,0|FF_PC,U,D,ledstrip/batch?zones=left_martix~matrix_8x8_mameoutput_1player~!LED_R!~!LED_G!~!LED_B!~255~1~false@right_martix~matrix_8x8_mameoutput_1player~!LED_R!~!LED_G!~!LED_B!~255~1~false
player2|ON|FF_DOF E78,0|FF_PC,U,D,ledstrip/batch?zones=left_martix~matrix_8x8_mameoutput_2players~!LED_R!~!LED_G!~!LED_B!~255~1~false@right_martix~matrix_8x8_mameoutput_2players~!LED_R!~!LED_G!~!LED_B!~255~1~false

[SCORE]
DELAY=5000

SD=30000:FF_PC,U,E,arcade/stream/mame/!ROM!?nogif&nomini&nostrip&event=InGame
SD=30000:FF_DMD,U,display/picture?path=mame/!ROM!&duration=-1


