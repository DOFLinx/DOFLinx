##################
#
# MAME configration for champbas
# DOFLinx force feedback configuration file v1
#
##################

[STARTUP]
BUTTON_COLOUR_CHANGE=BUT_EX,Orange,BUT_J1,yellow,BUT_B1,blue,BUT_B2,red,BUT_B3,orange
BUTTONS_LIT_ADDED=,BUT_J1,BUT_B3
KEY_TO_COMMAND=,BUT_B1,A:ChangeBatter,Pitcher1,BUT_B2,B:Bat,ExtraBases-Pitch,ThrowBall2,BUT_B3,C:Steal,RunBack3
FF_DOF=E78,-1

[SHUTDOWN]
KEY_TO_COMMAND=
BUTTONS_LIT_DELETED=,BUT_J1,BUT_B3

[COMMANDS]
A:ChangeBatter,Pitcher1|ON|FF_DOF E206,-1,|FF_PC,U,D,ledstrip/zone/left_strip/effect/gun_muzzle_trail?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
B:Bat,ExtraBases-Pitch,ThrowBall2|ON|FF_DOF E208,-1,|FF_PC,U,D,ledstrip/zone/left_strip/effect/explosion?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
C:Steal,RunBack3|ON|FF_DOF E210,-1,|FF_PC,U,D,ledstrip/zone/left_strip/effect/gun_explosion_pulse?r=!LED_R!&g=!LED_G!&b=!LED_B!&speed=255&intensity=255&loops=1
coin|ON|FF_DOF E78,0|FF_PC,U,D,ledstrip/batch?zones=left_speaker_ring~twinkle~!LED_R!~!LED_G!~!LED_B!~255~1~false@right_speaker_ring~twinkle~!LED_R!~!LED_G!~!LED_B!~255~1~false
player1|ON|FF_DOF E78,0|FF_PC,U,D,ledstrip/batch?zones=left_martix~matrix_8x8_mameoutput_1player~!LED_R!~!LED_G!~!LED_B!~255~1~false@right_martix~matrix_8x8_mameoutput_1player~!LED_R!~!LED_G!~!LED_B!~255~1~false
player2|ON|FF_DOF E78,0|FF_PC,U,D,ledstrip/batch?zones=left_martix~matrix_8x8_mameoutput_2players~!LED_R!~!LED_G!~!LED_B!~255~1~false@right_martix~matrix_8x8_mameoutput_2players~!LED_R!~!LED_G!~!LED_B!~255~1~false

[SCORE]
DELAY=5000

SD=30000:FF_PC,U,E,arcade/stream/mame/!ROM!?nogif&nomini&nostrip&event=InGame
SD=30000:FF_DMD,U,display/picture?path=mame/!ROM!&duration=-1


