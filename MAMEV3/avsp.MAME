[STARTUP]
BUTTON_COLOUR_CHANGE=BUT_EX,Red,BUT_P1,White,BUT_P2,White
COLOUR_PALETTE=White,Cyan,Red,Orange,Magenta
KEY_TO_COMMAND=BUT_B1,weapon,BUT_B2,punch,BUT_B3,jump
