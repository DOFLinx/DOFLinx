[STARTUP]
FF_ROM=fx2_swhansolo
BACKGLASS_EXISTS=YES
COLOUR_PALETTE=Dodger_Blue,Royal_Blue,Antique_White
BUTTON_COLOUR_CHANGE=BUT_LF,Dodger_Blue,BUT_RF,Dodger_Blue,BUT_ML,Antique_White,BUT_MR,Antique_White

[COMMANDS]
FLIPPER_LEFT_MIDDLE|ALIAS|Flipper_Left
FLIPPER_MID_RIGHT|ALIAS|Flipper_Right
FLIPPER_TOP_RIGHT|ALIAS|Flipper_Right
Nudge_Left|ON|FF_B2S B2SStartAnimation NUDGE
Nudge_Right|ON|FF_B2S B2SStartAnimation NUDGE
Nudge_Forward|ON|FF_B2S B2SStartAnimation NUDGE
BUMPER01|ON|FF_Flasher DV_FLIR,FL_TT,1,14,100,Royal_Blue|FF_B2S B2SStartAnimation BLUE
BUMPER02|ON|FF_Flasher DV_FLCN,FL_TT,1,12,100,Antique_White|FF_B2S B2SStartAnimation YELLOW
BUMPER03|ON|FF_Flasher DV_FLIL,FL_TT,1,14,100,Red|FF_B2S B2SStartAnimation RED
LEFT_SLING_COLLISION_BOTTOM|ON|FF_B2S B2SStartAnimation WOOKIEE
RIGHT_SLING_COLLISION_BOTTOM|ON|FF_B2S B2SStartAnimation HAN
SENSOR_LEFT_LOOP03|ON|FF_Flasher DV_FLOL,FL_TT,1,15,100,Antique_White|FF_DOF E410,-1|FF_B2S B2SStartAnimation HEAD_CHEWIE
SENSOR_MIDDLE_LOOP03|ON|FF_Flasher DV_FLCN,FL_TT,1,15,100,Navy|FF_DOF E413,-1|FF_B2S B2SStartAnimation SHIMMER
SENSOR_RIGHT_LOOP03|ON|FF_Flasher DV_FLOR,FL_TT,1,15,100,Antique_White|FF_DOF E414,-1|FF_B2S B2SStartAnimation HEAD_HAN
SENSOR_SPINNER03|ON|FF_Dev DV_BK,1500|FF_DOF E418,-1|FF_B2S B2SStartAnimation SPINNER
SENSOR_CENTER_RAMP03|ON|FF_Flasher DV_FLCN,FL_TT,1,12,100,Royal_Blue|FF_DOF E412,-1|FF_B2S B2SStartAnimation HALL
SENSOR_CROSS_RAMP03|ON|FF_Flasher DV_FLOL,FL_TT,1,30,100,Red|FF_Flasher DV_FLIL,FL_TT,1,40,100,Red|FF_Flasher DV_FLCN,FL_TT,1,50,100,Red|FF_Flasher DV_FLIR,FL_TT,1,60,100,Red|FF_Flasher DV_FLOR,FL_TT,1,70,100,Red|FF_DOF E411,-1|FF_B2S B2SStartAnimation SHOOT_150
SENSOR_LEFT_RAMP|ON|FF_Flasher DV_FLOL,FL_TT,1,15,100,Antique_White|FF_B2S B2SStartAnimation CHEWIE
SENSOR_RIGHT_RAMP|ON|FF_Flasher DV_FLOR,FL_TT,1,15,100,Dodger_Blue|FF_B2S B2SStartAnimation SOLO
SENSOR_SINKHOLE_01|ON|FF_B2S B2SStopAllAnimations|FF_B2S B2SStartAnimation SINKHOLE_1
SENSOR_SINKHOLE_02|ON|FF_B2S B2SStopAllAnimations|FF_Dev DV_GR,500|FF_DOF E419,-1|FF_B2S B2SStartAnimation SINKHOLE_2
SENSOR_SAUCER|ON|FF_B2S B2SStopAllAnimations|FF_Flasher DV_FLOR,FL_TT,1,12,100,Dodger_Blue|FF_B2S B2SStartAnimation LIGHTSHOW

